# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# --- Sanity (CMS) ---
# Project ID + dataset from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor-permission token, server-side only. Needed for write scripts, not for the site.
SANITY_API_TOKEN=

# --- Auth0 (admin login) ---
# auth0.com -> Applications -> your app -> Settings
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption key: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- EmailJS (contact form) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
